{
  "allowedTools": [
    "Bash(npx tsc --noEmit)",
    "Bash(cargo check)",
    "Bash(cargo check*)",
    "Bash(cargo clippy*)",
    "Bash(git log*)",
    "Bash(git diff*)",
    "Bash(git status)",
    "Bash(git status*)",
    "Bash(grep*)",
    "Bash(find*)",
    "Bash(npm list*)",
    "Bash(npm outdated)",
    "Bash(npm run build)"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit 2>&1 | head -20"
          }
        ]
      }
    ]
  }
}
